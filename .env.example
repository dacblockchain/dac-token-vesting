# Deployer key — the factory owner. Use a hardware wallet / multisig-controlled key in production.
PRIVATE_KEY=0x...

# Deployed DACt ERC-20 token address
DACT_TOKEN=0x...

# Vesting start (unix seconds), e.g. TGE timestamp
TGE_TIMESTAMP=1767225600

# RPC endpoint of the target chain (e.g. DAC testnet / mainnet)
RPC_URL=https://...

# Comma-separated grant configuration. Each list must have the same length.
GRANT_BENEFICIARIES=0x...,0x...
GRANT_BUCKET_NAMES=PARTNERS,ADVISORS
GRANT_DURATION_MONTHS=36,18
GRANT_CLIFF_MONTHS=12,6
GRANT_AMOUNTS=250000000000000000000000,50000000000000000000000
